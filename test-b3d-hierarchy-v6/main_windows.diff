+func setBuildControlsEnabled(enabled bool) {
+	v := uintptr(0)
+	if enabled {
+		v = 1
+	}
+	pEnableWindow.Call(btnHwnd, v)
+	pEnableWindow.Call(simplifyNoneHwnd, v)
+	pEnableWindow.Call(simplifyMediumHwnd, v)
+	pEnableWindow.Call(simplifyStrongHwnd, v)
+}
+
+func postBuildResult(out string, err error) {
+	resultMu.Lock()
+	pendingBuildResult = &buildResult{out: out, err: err}
+	resultMu.Unlock()
+	pPostMessageW.Call(mainHwnd, WM_BUILD_DONE, 0, 0)
+}
+
+func consumeBuildResult() *buildResult {
+	resultMu.Lock()
+	r := pendingBuildResult
+	pendingBuildResult = nil
+	resultMu.Unlock()
+	return r
+}
