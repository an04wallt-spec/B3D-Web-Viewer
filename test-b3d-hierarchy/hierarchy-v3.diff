+func selectionLeafForTriangle(a, b, c v3, material string, leaves []selectionLeaf) int {
+	cent := [3]float64{(a.X + b.X + c.X) / 3, (a.Y + b.Y + c.Y) / 3, (a.Z + b.Z + c.Z) / 3}
+	nm := normalizeMaterial(material)
+	best := -1
+	bestScore := math.Inf(1)
+	for li, leaf := range leaves {
+		matPenalty := 0.0
+		lm := normalizeMaterial(leaf.Material)
+		if lm != "" && lm != "noname" && nm != "" && lm != nm {
+			matPenalty = 0.25
+		}
+		inside := true
+		score := matPenalty
+		vol := 1.0
+		for ax := 0; ax < 3; ax++ {
+			pad := 1.0
+			if cent[ax] < leaf.Min[ax]-pad || cent[ax] > leaf.Max[ax]+pad {
+				inside = false
+				break
+			}
+			sz := math.Max(1, leaf.Max[ax]-leaf.Min[ax])
+			mid := (leaf.Min[ax] + leaf.Max[ax]) * 0.5
+			d := (cent[ax] - mid) / sz
+			score += d * d
+			vol *= sz
+		}
+		if !inside {
+			continue
+		}
+		score += math.Log1p(vol) * 1e-6
+		if score < bestScore {
+			bestScore = score
+			best = li
+		}
+	}
+	return best
+}
